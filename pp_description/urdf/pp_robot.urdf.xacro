<?xml version="1.0"?>
<!--
  Work cell: UR5e on a table, parallel gripper, RGB-D camera looking down at the workspace.
  The table surface is the world z = 0 plane; the robot base sits on it at the origin and the
  objects lie in front of the robot (x > 0).
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="pp_robot">
  <xacro:arg name="sim_gazebo" default="true"/>
  <xacro:arg name="controllers_file" default="$(find pp_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="num_objects" default="3"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro"/>
  <xacro:include filename="$(find pp_description)/urdf/parallel_gripper.xacro"/>

  <link name="world"/>

  <!-- Table: 1.2 m x 1.2 m, top at z = 0. -->
  <joint name="table_joint" type="fixed">
    <parent link="world"/>
    <child link="table"/>
    <origin xyz="0.35 0 -0.02"/>
  </joint>
  <link name="table">
    <visual>
      <geometry><box size="1.2 1.2 0.04"/></geometry>
      <material name="table_wood"><color rgba="0.75 0.6 0.42 1"/></material>
    </visual>
    <collision>
      <geometry><box size="1.2 1.2 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="2.4" ixy="0" ixz="0" iyy="2.4" iyz="0" izz="4.8"/>
    </inertial>
  </link>

  <!-- UR5e -->
  <xacro:ur_robot
    name="ur"
    tf_prefix=""
    parent="world"
    joint_limits_parameters_file="$(find pp_description)/config/ur5e_joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur5e/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml"
    safety_limits="false"
    force_abs_paths="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <xacro:parallel_gripper parent="tool0"/>

  <!-- RGB-D camera above the workspace, x axis (optical axis in Gazebo) pointing down. -->
  <joint name="camera_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_link"/>
    <origin xyz="0.5 0.0 0.95" rpy="0 ${pi / 2} 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.1 0.03"/></geometry>
      <material name="camera_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <!-- Needed in simulation: the URDF to SDF conversion silently drops a link without
         inertia that is fixed to the world, and its sensor with it. -->
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <xacro:if value="$(arg sim_gazebo)">
    <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.0</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>2.5</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>2.5</far>
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

    <!-- ros2_control: arm (position / velocity / effort) and gripper (position). -->
    <xacro:ur_ros2_control
      name="ur"
      tf_prefix=""
      initial_positions="${dict(shoulder_pan_joint=0.0, shoulder_lift_joint=-1.75, elbow_joint=1.75, wrist_1_joint=-1.57, wrist_2_joint=-1.57, wrist_3_joint=0.0)}"/>
    <xacro:parallel_gripper_ros2_control/>
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_file)</parameters>
      </plugin>
    </gazebo>

    <!--
      Grasping: closing the fingers on an object in Gazebo is not reliable enough to carry it
      (friction-only grasps slip), so after the fingers have closed the task manager attaches
      the object to the wrist with a detachable fixed joint. The fixed links of the gripper are
      merged into wrist_3_link by the URDF to SDF conversion, hence the parent link.
      The plugin creates the joint at startup: the bringup detaches every object right away.
    -->
    <xacro:macro name="detachable_object" params="index">
      <gazebo>
        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
          <parent_link>wrist_3_link</parent_link>
          <child_model>object_${index}</child_model>
          <child_link>link</child_link>
          <attach_topic>/object_${index}/attach</attach_topic>
          <detach_topic>/object_${index}/detach</detach_topic>
          <output_topic>/object_${index}/state</output_topic>
          <suppress_child_warning>true</suppress_child_warning>
        </plugin>
      </gazebo>
      <xacro:if value="${index > 0}">
        <xacro:detachable_object index="${index - 1}"/>
      </xacro:if>
    </xacro:macro>
    <xacro:detachable_object index="${$(arg num_objects) - 1}"/>
  </xacro:if>
</robot>
