<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_control_core</name>
  <version>0.1.0</version>
  <description>ROS-agnostic model-based arm control: Pinocchio rigid-body model, trajectory interpolation, computed-torque and Cartesian impedance laws.</description>
  <maintainer email="sebastiano.comai@outlook.it">Sebastiano Comai</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/ssebba/vision_pick_place</url>
  <author email="sebastiano.comai@outlook.it">Sebastiano Comai</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>
  <buildtool_export_depend>eigen3_cmake_module</buildtool_export_depend>

  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>
  <depend>pinocchio</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ur_description</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
