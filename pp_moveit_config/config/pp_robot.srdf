<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description of the work cell for MoveIt. The disable-collision entries below the
  marker are generated with `ros2 run moveit_setup_assistant collisions_updater`.
-->
<robot name="pp_robot">
  <group name="arm">
    <chain base_link="base_link" tip_link="gripper_tcp"/>
  </group>
  <group name="gripper">
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint" value="0.0"/>
    <joint name="shoulder_lift_joint" value="-1.75"/>
    <joint name="elbow_joint" value="1.75"/>
    <joint name="wrist_1_joint" value="-1.57"/>
    <joint name="wrist_2_joint" value="-1.57"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <!-- Arm turned aside, out of the camera field of view, for object detection. -->
  <group_state name="observe" group="arm">
    <joint name="shoulder_pan_joint" value="1.9"/>
    <joint name="shoulder_lift_joint" value="-1.75"/>
    <joint name="elbow_joint" value="1.75"/>
    <joint name="wrist_1_joint" value="-1.57"/>
    <joint name="wrist_2_joint" value="-1.57"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0.0425"/>
    <joint name="right_finger_joint" value="0.0425"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="left_finger_joint" value="0.0"/>
    <joint name="right_finger_joint" value="0.0"/>
  </group_state>

  <end_effector name="gripper" parent_link="tool0" group="gripper" parent_group="arm"/>

  <!-- Generated by collisions_updater (default, always and never-colliding pairs, 20000 trials).
       gripper_base / table was removed by hand: it collides only in the zero configuration. -->
    <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="base_link_inertia" link2="table" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="gripper_base" link2="left_finger" reason="Adjacent"/>
    <disable_collisions link1="gripper_base" link2="right_finger" reason="Adjacent"/>
    <disable_collisions link1="gripper_base" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="gripper_base" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="gripper_base" link2="wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="left_finger" link2="right_finger" reason="Never"/>
    <disable_collisions link1="left_finger" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="left_finger" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="left_finger" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="right_finger" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="right_finger" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="right_finger" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="table" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
</robot>
